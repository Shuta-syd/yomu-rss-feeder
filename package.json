    "db:studio": "drizzle-kit studio",
    "icons:build": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.4.0",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^29.1.1",
    "marked": "^18.0.2",
    "next": "16.2.6",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.6",
    "png-to-ico": "^3.0.1",
    "postcss": "8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
